DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/atlas
REDIS_URL=redis://localhost:6380/0
# 模型网关地址（Anthropic 原生 /v1/messages 协议）
LITELLM_BASE_URL=https://your-gateway.example.com
LITELLM_KEY=sk-replace-me
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# 远程 MCP server（JSON 数组）。凭据写 ${ENV_VAR} 占位符，真值放环境变量 ——
# 凭据不落配置、不进 agent_version.spec（spec 会被 API 原样返回）。
# MCP_SERVERS=[{"name":"calc","url":"http://127.0.0.1:8931/mcp","headers":{"Authorization":"Bearer ${CALC_TOKEN}"}}]

# ── 会话工作区（对象存储，S3 兼容 API）─────────────────────────────
# 不配就没有文件能力 —— 工具一个都不注册，而不是回落到内存实现。
# 回落会让模型以为自己有持久工作区：写完文件、下一轮发现不见了，却从未
# 收到任何提示。
#
# 默认指向 docker-compose 里的 MinIO（make up 自带，桶由 minio-init 建好）。
# 换生产对象存储只改这几个值，服务端代码不用动。
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_BUCKET=atlas-dev
OSS_ACCESS_KEY_ID=atlas
OSS_ACCESS_KEY_SECRET=atlas-local-dev
# ★ path：MinIO 默认只认 path-style，virtual-host 风格要另配 MINIO_DOMAIN，
#   而 127.0.0.1 这种 IP 端点本来也没法做 <bucket>.<host> 的子域寻址。
OSS_ADDRESSING_STYLE=path
# MinIO 不分区域，随便给一个让 SigV4 签名两边对得上即可。
OSS_REGION=us-east-1
# 控制台 http://127.0.0.1:9001 （账号 / 密码同上面两行）

# 下面是 GCS 的 S3 兼容 XML API（凭据用 HMAC key，不是服务账号 JSON）：
#   gcloud storage buckets create gs://<桶名> --uniform-bucket-level-access
#   gcloud storage hmac create <服务账号邮箱>
# OSS_ENDPOINT=https://storage.googleapis.com
# OSS_BUCKET=atlas-agent-session
# OSS_ACCESS_KEY_ID=GOOG...
# OSS_ACCESS_KEY_SECRET=...
# ★ region 必须给：SigV4 要拿它参与签名，而 GCS 不是按 AWS 区域划分的。
#   给 auto 让 botocore 别去猜一个对不上的区域。
# OSS_REGION=auto
# ★ path：GCS 的 XML API 不支持 virtual-host 风格的桶名寻址。
# OSS_ADDRESSING_STYLE=path

# ── 遥测（可观测性设计 §02）─────────────────────────────────────────
# 只往 Collector 发 OTLP，不直连任何后端 —— 脱敏与分流都在 Collector 里做。
# make up 会起 Collector(4318) 与 Jaeger，UI 在 http://127.0.0.1:16686
# OTEL_ENABLED=true
# OTEL_ENDPOINT=http://127.0.0.1:4318
# ★ 内容采集（提示词与回答原文）默认关，且应当一直关着：那里面有用户的
#   私有代码与密钥，进了遥测管道就与业务数据的留存/访问控制脱钩了。
# OTEL_CAPTURE_CONTENT=false

# ── 跨会话记忆（记忆设计）──────────────────────────────────────────
# 本轮只做**抽取与存储**，不向任何 Agent 暴露 —— 先观察提炼质量，达标
# 之后再开检索工具，最后才开自动注入（§12 的上线顺序）。
# 向量库是 make up 起的 Qdrant；embedding 用本地 FastEmbed，不需要 key。
# MEMORY_ENABLED=true
# MEMORY_QDRANT_URL=http://127.0.0.1:6333
# 抽取用的模型走 DeepSeek 的 OpenAI 兼容端点（与平台的 Anthropic 端点不同）
# MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
# MEMORY_LLM_MODEL=deepseek-flash
